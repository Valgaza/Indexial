# -----------------------------------------------------------------------------
# Indexial
#
# Rewritten from a stock Python template. Two of its patterns were unanchored
# and silently swallowed real source:
#
#   lib/    matched frontend/lib/ at any depth, so lib/utils.ts, lib/api.ts and
#           lib/types.ts were never committed - and all 49 components/ui/*.tsx
#           import `cn` from @/lib/utils, so the whole frontend failed to build.
#   tests/  would have done the same to backend/tests/.
#
# Anchor directory patterns with a leading slash. A negation such as
# !frontend/lib/** cannot rescue them: git will not re-include files inside an
# excluded directory.
#
# Verify with:  git check-ignore -v <path>
# -----------------------------------------------------------------------------

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
/downloads/
/eggs/
.eggs/
/lib/
/lib64/
/sdist/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type checkers / linters
.mypy_cache/
.dmypy.json
.ruff_cache/
.pyre/

# Jupyter
.ipynb_checkpoints/

# Runtime artifacts (regenerated by the pipeline; wiped by /api/reset)
/output/
/uploads/

# Node / Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
*~
*.fileloc
